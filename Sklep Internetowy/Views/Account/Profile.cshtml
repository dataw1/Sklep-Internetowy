@model Sklep_Internetowy.Models.ProfilViewModel

@{
    ViewData["Title"] = "Mój Profil";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0 fs-5"><i class="bi bi-person-circle me-2"></i>Dane mojego konta</h4>
                </div>
                <div class="card-body p-4">

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Profile" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-bold"></label>
                            <input asp-for="Email" class="form-control bg-light" readonly />
                            <small class="text-muted">Adres e-mail jest identyfikatorem Twojego konta i nie podlega edycji.</small>
                        </div>

                        <h5 class="mt-4 mb-3 border-bottom pb-2">Dane osobowe</h5>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Imie" class="form-label"></label>
                                <input asp-for="Imie" class="form-control" />
                                <span asp-validation-for="Imie" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Nazwisko" class="form-label"></label>
                                <input asp-for="Nazwisko" class="form-control" />
                                <span asp-validation-for="Nazwisko" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Telefon" class="form-label"></label>
                                <input asp-for="Telefon" class="form-control" />
                                <span asp-validation-for="Telefon" class="text-danger small"></span>
                            </div>
                        </div>

                        <h5 class="mt-4 mb-3 border-bottom pb-2">Adres dostawy</h5>
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label asp-for="Ulica" class="form-label"></label>
                                <input asp-for="Ulica" class="form-control" />
                                <span asp-validation-for="Ulica" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="NumerDomu" class="form-label"></label>
                                <input asp-for="NumerDomu" class="form-control" />
                                <span asp-validation-for="NumerDomu" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="KodPocztowy" class="form-label"></label>
                                <input asp-for="KodPocztowy" class="form-control" />
                                <span asp-validation-for="KodPocztowy" class="text-danger small"></span>
                            </div>
                            <div class="col-md-8">
                                <label asp-for="Miasto" class="form-label"></label>
                                <input asp-for="Miasto" class="form-control" />
                                <span asp-validation-for="Miasto" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                                &larr; Powrót do sklepu
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-save me-1"></i> Zapisz zmiany
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
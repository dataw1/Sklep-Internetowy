@model List<Sklep_internetowy.Controllers.CartItem>

@{
    ViewData["Title"] = "Koszyk zakupowy";
    decimal totalSum = Model?.Sum(item => item.Total) ?? 0;
}

<div class="container my-5">
    <div class="row">
        <div class="col-lg-8">
            <h2 class="mb-4">Twój Koszyk 🛒</h2>

            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info text-center py-4">
                    <h5>Twój koszyk jest pusty</h5>
                    <p class="mb-0">Nie dodałeś jeszcze żadnych produktów do zamówienia.</p>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Wróć do zakupów</a>
                </div>
            }
            else
            {
                <div class="card shadow-sm border-0 mb-4">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Produkt</th>
                                    <th>Cena</th>
                                    <th>Ilość</th>
                                    <th>Suma</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <strong>@item.Name</strong>
                                        </td>
                                        <td>@item.Price.ToString("C2")</td>
                                        <td>
                                            <input type="number" class="form-control form-control-sm" value="@item.Quantity" min="1" style="width: 70px;">
                                        </td>
                                        <td class="fw-bold">@item.Total.ToString("C2")</td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-danger" title="Usuń produkt">&times;</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">&larr; Kontynuuj zakupy</a>
            }
        </div>

        <div class="col-lg-4 mt-4 mt-lg-0">
            <div class="card shadow-sm border-0 p-4">
                <h4 class="card-title mb-3">Podsumowanie</h4>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Wartość produktów:</span>
                    <span>@totalSum.ToString("C2")</span>
                </div>
                <div class="d-flex justify-content-between mb-3">
                    <span class="text-muted">Dostawa:</span>
                    <span class="text-success">Darmowa</span>
                </div>
                <hr>
                <div class="d-flex justify-content-between mb-4">
                    <span class="fs-5 fw-bold">Razem do zapłaty:</span>
                    <span class="fs-5 fw-bold text-primary">@totalSum.ToString("C2")</span>
                </div>
                <button class="btn btn-success btn-lg w-100" @(totalSum == 0 ? "disabled" : "")>
                    Przejdź do kasy
                </button>
            </div>
        </div>
    </div>
</div>
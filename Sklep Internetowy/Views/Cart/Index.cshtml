@model List<Sklep_Internetowy.Models.CartItem>
@{
    ViewData["Title"] = "Koszyk zakupowy";
    decimal sumaCalkowita = Model?.Sum(x => x.Suma) ?? 0;
}

<div class="container py-3">
    <h2 class="mb-4">Twój Koszyk 🛒</h2>

    @if (TempData["CartWarning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @TempData["CartWarning"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive bg-white rounded shadow-sm p-3 mb-4">
            <table class="table align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Produkt</th>
                        <th>Cena</th>
                        <th>Ilość</th>
                        <th>Suma</th>
                        <th class="text-center">Usuń</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.Nazwa</td>
                            <td>@item.Cena.ToString("C")</td>
                            <td>
                                <span class="badge bg-light text-dark border px-3 py-2">@item.Ilosc</span>
                            </td>
                            <td class="fw-bold">@item.Suma.ToString("C")</td>
                            <td class="text-center">
                                <a asp-controller="Cart" asp-action="Remove" asp-route-id="@item.IdProdukt" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-x-lg"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm mt-2">
                &larr; Kontynuuj zakupy
            </a>
        </div>

        <div class="row justify-content-end">
            <div class="col-md-5">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <h4 class="card-title mb-3">Podsumowanie</h4>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Wartość produktów:</span>
                            <span class="fw-bold">@sumaCalkowita.ToString("C")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span>Dostawa:</span>
                            <span class="text-success fw-bold">Darmowa</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <span class="fs-5 fw-bold">Razem do zapłaty:</span>
                            <span class="fs-4 fw-bold text-primary">@sumaCalkowita.ToString("C")</span>
                        </div>
                        <a asp-controller="Cart" asp-action="Checkout" class="btn btn-success btn-lg w-100">
                            Przejdź do kasy
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5 bg-white rounded shadow-sm">
            <i class="bi bi-cart-x text-muted" style="font-size: 4rem;"></i>
            <h4 class="mt-3 text-muted">Twój koszyk jest pusty.</h4>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">
                Wróć do sklepu i wybierz produkty
            </a>
        </div>
    }
</div>
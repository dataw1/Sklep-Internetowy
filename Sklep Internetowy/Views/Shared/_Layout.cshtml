<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sklep Internetowy</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-md navbar-dark bg-dark shadow-sm py-2">
            <div class="container">
                
                <a class="navbar-brand d-flex align-items-center fw-bold fs-4" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-shop text-primary me-2"></i>Sklep Internetowy
                </a>

                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Przełącz nawigację">
                    <span class="navbar-toggler-icon"></span>
                </button>

             
                <div class="collapse navbar-collapse" id="navbarContent">
                    
                    <ul class="navbar-nav me-auto mb-2 mb-md-0">
                        <li class="nav-item">
                            <a class="nav-link px-2" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-grid me-1"></i>Katalog
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-2" asp-controller="Home" asp-action="Privacy">
                                Polityka prywatności
                            </a>
                        </li>
                    </ul>

                   
                    <div class="d-flex flex-column flex-md-row align-items-md-center gap-2 mt-2 mt-md-0">
                        <a class="btn btn-outline-light d-flex align-items-center justify-content-center" asp-controller="Cart" asp-action="Index">
                            <i class="bi bi-cart3 me-1"></i>Koszyk
                        </a>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <span class="navbar-text text-white px-2 py-1">
                                <i class="bi bi-person-circle text-info me-1"></i>@User.Identity.Name
                            </span>
                            <a class="btn btn-sm btn-outline-danger" asp-controller="Account" asp-action="Logout">
                                Wyloguj
                            </a>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="Login">
                                Logowanie
                            </a>
                            <a class="btn btn-sm btn-primary" asp-controller="Account" asp-action="Register">
                                Rejestracja
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1 my-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer bg-white border-top py-3 mt-auto text-muted">
        <div class="container text-center">
            &copy; 2026 - Sklep Internetowy | Projekt Zespołowy
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>